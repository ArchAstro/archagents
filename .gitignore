.DS_Store

# Python bytecode caches — match at any depth so `scripts/__pycache__/`
# and `scripts/_sample_lib/__pycache__/` (etc.) are both covered.
__pycache__/

# uv-managed virtualenv. The lock file (uv.lock) is committed; the
# resolved venv at .venv is not — `uv run` recreates it on demand.
.venv/

# Local review-tool scratch directory (filament). Not part of the repo.
.filament/

# Local tarball output from scripts/build-releases.sh. CI produces these
# as GitHub Release assets; local builds are for smoke-testing only.
releases/
