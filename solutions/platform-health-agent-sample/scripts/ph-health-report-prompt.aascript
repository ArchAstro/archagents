// Daily prompt-emitter for the health report.
//
// Posts a prompt to the `health-reports` thread. The agent's `participate`
// routine sees the new message, generates the report, and the deliver script
// forwards the response to Slack. The capture script extracts the trailing
// `<summary>` block and persists it for tomorrow's prompt as continuity.

let threads = import("threads")
let storage = import("storage")
let str = import("string")
let dt = import("datetime")

// Yesterday's continuity summary, written by ph-capture. 3-day TTL covers
// weekend gaps so a Sunday/Monday absence doesn't lose context.
let yesterday = unwrap(storage.get("last_report_summary"), "")

let yesterday_section = if (yesterday != "") {
  "\n\n**Yesterday's continuity summary** (use as starting context — focus on what's new or changed since, do not reiterate items still listed there):\n" + yesterday
} else {
  ""
}

let today_iso = str.toString(dt.now())
let monitored_repo = env.MONITORED_REPO
let has_monitored_repo = monitored_repo != null && monitored_repo != ""
let repo_label = if (has_monitored_repo) { monitored_repo } else { "(MONITORED_REPO unset)" }

// Pre-split owner/repo so the prompt can embed concrete values for the
// `github_create_issue_comment` tool call (no agent-side string parsing)
// and the markdown-link templates can reference https://github.com/<owner>/<repo>/...
let slash_idx = if (has_monitored_repo) { str.indexOf(monitored_repo, "/") } else { -1 }
let owner = if (slash_idx >= 0) { str.substring(monitored_repo, 0, slash_idx) } else { "" }
let repo = if (slash_idx >= 0) { str.substring(monitored_repo, slash_idx + 1) } else { "" }
let repo_url_root = "https://github.com/" + owner + "/" + repo

let base_prompt = "Today is " + today_iso + ".\n\n" +
  "Generate today's daily health report for " + repo_label + ". Be concise — use bullet points, not paragraphs.\n\n" +
  "**Output structure (in this order):**\n\n" +
  "1. **TL;DR** — 2-3 lines max. What changed today and what needs attention?\n" +
  "2. **Notable** — Top 1-3 items needing immediate attention (from anywhere — issues, CI, PRs, infrastructure). One line each plus linked PR/issue. Roll any 'unusual but not urgent' notes in here too rather than a separate section.\n" +
  "3. **CI Status** — Is main green? One line. If failures, name them and link the workflow run. Use user-friendly descriptions, not internal test-path identifiers.\n" +
  "4. **Issues needing attention** — Group by theme (analytics, auth, infrastructure, agent runtime, etc.). **One bullet per theme** with all related items linked in parentheses and a suggested owner. NO per-item commentary unless P0/P1 — trust the links to carry detail. Example: `Analytics — data loss ([issue #4418](" + repo_url_root + "/issues/4418), fix [PR #4419](" + repo_url_root + "/pull/4419) open), drilldown ([issue #4372](" + repo_url_root + "/issues/4372)) → rob`.\n" +
  "5. **Possibly resolved** — issues that ARE STILL OPEN on GitHub and appear resolved by a recently MERGED PR (cross-reference 'fixes #X' / 'closes #X' in PR bodies). For each candidate issue N: (a) verify it's currently OPEN on GitHub — if already closed, skip (there's nothing to suggest). (b) call `working_memory_get(key='commented_on_issue_<N>')` — if a marker is set, skip the entire item (you've already handled it; don't re-list). For surviving items only: call `github_create_issue_comment(owner='" + owner + "', repo='" + repo + "', issue_number=<N>, body='<1-2 sentence summary citing the merged PR(s)>')` — this is the integrations-builtin tool backed by the GitHub App's installation token (Calvin uses the same), NOT a PAT — then `working_memory_set(key='commented_on_issue_<N>', value='<brief context>')`. Use the KV memory tool, not vector-search. Report output: one line per surviving item — linked issue + linked culprit PR.\n" +
  "6. **Customer fixes/ships** — user-facing merges since last Saturday 09:00 UTC. Compute the cutoff and state it explicitly (e.g., 'since 2026-04-25 09:00 UTC'). **One bullet per theme** with linked PRs in parentheses. NO per-PR descriptions — let the links speak. Skip internal refactors, CI fixes, dependency bumps.\n\n" +
  "**Conventions:**\n" +
  "- Render PR/issue references as markdown links to GitHub: `[PR #X](" + repo_url_root + "/pull/X)` for pull requests, `[issue #Y](" + repo_url_root + "/issues/Y)` for issues. Never use bare `PR #X` text — readers should be able to click through.\n" +
  "- Trust the links to carry detail. Don't paraphrase PR descriptions — readers click through for full context.\n" +
  "- Stick to source data. No severity claims absent from issue title/labels. No extrapolated impact.\n\n" +
  "At the very end of your report, include EXACTLY this block (replace the bullet lines with your continuity summary):\n\n" +
  "<summary>\n" +
  "- Most important open issue today: ...\n" +
  "- Active sprint context (if any): ...\n" +
  "- Anything tomorrow's report should pick up on: ...\n" +
  "</summary>\n\n" +
  "The platform extracts the <summary> block automatically and stores it for tomorrow's continuity. Do NOT call working_memory_set yourself — the capture is handled by a separate routine. Keep the summary terse — 3-5 lines max.\n\n" +
  "Respond with ONLY the report. Do not post it anywhere else."

let prompt = base_prompt + yesterday_section

let thread = unwrap(threads.ensure_by_key({
  key: "health-reports",
  title: "Daily Health Reports"
}))

unwrap(threads.send_message({
  thread: thread.id,
  content: prompt
}))

{status: "prompted", thread_id: thread.id, has_yesterday_context: yesterday != ""}
