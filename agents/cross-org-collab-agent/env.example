# Required env vars for the Cross-Org Collaboration Agent
# Copy to .env and fill in your values, then run ./deploy.sh

# GitHub token used by the sample's custom scripts to read code, create
# branches, commit files, and open PRs. Prefer a fine-grained PAT with
# Contents: read/write, Pull requests: read/write, and Metadata: read.
# A classic `repo` token also works.
GITHUB_TOKEN=ghp_your_token_here

# Your GitHub org and the repo the agent will read/write
REPO_OWNER=your-org
REPO_NAME=your-repo

# One-line description of your stack — used in the agent identity prompt
STACK_DESCRIPTION="Python/Django backend, React frontend, AWS infra"
