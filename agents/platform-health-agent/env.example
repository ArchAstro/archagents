# Required env vars for the Platform Health Agent
# Set each on your ArchAgents org via: archagent create orgenvvar --key NAME --value VAL
# (the agent's scripts read them at runtime via env.NAME).

# --- GitHub ---

# PAT with `repo` scope. The agent uses this to read issues, PRs, and comments,
# and to post resolution comments back on issues.
GITHUB_TOKEN=ghp_your_token_here

# The repo to monitor — owner/name format. The agent only acts on events from
# this repo (other repos that the same GitHub App receives events for are
# silently ignored).
MONITORED_REPO=your-org/your-repo

# --- Slack ---

# Channel that receives the daily report, GitHub event alerts, weekly release
# notes (if enabled separately), and 5xx digest. Include the leading '#'.
SLACK_OUTPUT_CHANNEL=#platform-health

# --- GCP Cloud Logging (for the 5xx daily digest) ---
# The 5xx digest queries Cloud Logging directly. We mint a fresh access token
# from a service account on every run via JWT-bearer grant.

# Project ID hosting the namespace whose logs you want to scan.
GCLOUD_PROJECT_ID=your-gcp-project

# Kubernetes namespace whose ERROR-severity logs the digest scans.
LOG_NAMESPACE=production-your-platform-namespace

# Service account email and private key (PEM). When you download the SA key
# JSON from GCP, copy `client_email` and `private_key` into these two vars
# separately. For the private key, escape newlines as literal `\n`.
GCLOUD_SA_CLIENT_EMAIL=logs-reader@your-gcp-project.iam.gserviceaccount.com
GCLOUD_SA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n
